# Frontend configuration for the World ID Live Check sample.
# Copy this file to `.env` and fill in your deployed Cognito stack outputs.
# Do NOT commit `.env` (it is gitignored) — it holds your pool/client identifiers.

# Cognito settings (from the backend stack outputs: CognitoUserPoolId, CognitoUserPoolClientId).
# The region is part of the user pool ID, so it isn't configured separately.
VITE_USER_POOL_ID="us-east-1_XXXXXXXXX"
VITE_USER_POOL_CLIENT_ID="XXXXXXXXXXXXXXXXXXXXXXXXXX"
